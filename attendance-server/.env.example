# Copy to .env and adjust. .env is gitignored; this file is not.

APP_NAME="Attendance API"
ENV=dev

# The company's wall-clock timezone. Shift rules are compared in this zone;
# instants are stored in UTC.
TIMEZONE=Asia/Kolkata
DEBUG=true

# Port 5433, not 5432 — a native PostgreSQL service already holds 5432 on this
# machine, so docker-compose publishes the container one port higher.
DATABASE_URL=postgresql+asyncpg://attendance:dev_only_password@localhost:5433/attendance

# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-anything-leaves-your-laptop
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=http://localhost:5173
